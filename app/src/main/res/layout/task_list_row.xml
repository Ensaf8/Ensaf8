<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/colorPrimary"
        card_view:cardCornerRadius="7dp"
        card_view:contentPadding="10dp">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="11dp"
                android:layout_marginRight="11dp"
                app:srcCompat="@drawable/ic_alarm_black_24dp"
                tools:ignore="VectorDrawableCompat" />

            <TextView
                android:id="@+id/CusActReTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/d1Gray"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="53dp"
                android:layout_marginEnd="68dp"
                android:layout_marginRight="68dp"
                android:text="تماس برای پیگیری پلان"
                android:textSize="17dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/CusActReDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="14dp"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="88dp"
                android:textColor="@color/colorAccent"
                android:text="1398/06/29  10:15 am" />

            <CheckBox
                android:id="@+id/CusActReCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                app:buttonTint="@color/d1Gray"
                android:layout_marginStart="23dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="40dp"
                android:scaleX="2"
                android:scaleY="2" />

            <TextView
                android:id="@+id/CusActReMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/d1Gray"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="82dp"
                android:layout_marginEnd="39dp"
                android:layout_marginRight="39dp"
                android:text="تماس گرفتم گفت که حتما می فرستم"
                android:maxLength="20"
                android:ellipsize="marquee"
                android:singleLine="true" />

            <TextView
                android:id="@+id/txt_tasks_customer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/d1Gray"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="71dp"
                android:layout_marginRight="71dp"
                android:text="مهندس پرندک"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>