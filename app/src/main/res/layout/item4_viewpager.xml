<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container3"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.cardview.widget.CardView
        android:id="@+id/card04_view_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        card_view:cardCornerRadius="2dp"
        card_view:contentPadding="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:orientation="vertical">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imv_item04_ic_profile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_profile" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_item04_consname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imv_item03_ic_profile"
        android:layout_marginTop="25dp"
        android:textAlignment="center"
        android:textColor="@color/darkGray"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="آقای حسینی" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_item04_conposi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_below="@+id/txt_item03_consname"
        android:layout_marginTop="10dp"
        android:textColor="@color/darkGray"
        android:textSize="10sp"
        tools:text="مهندس پروژه" />
    </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>